generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs            Club[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  leagueMessages   LeagueMessage[] @relation("LeagueMessages")
}

enum MessageType {
  TEXT
  TRANSFER_OFFER
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Message {
  id          String       @id @default(cuid())
  leagueId    String
  fromUserId  String
  toUserId    String
  text        String?
  type        MessageType  @default(TEXT)
  instanceId  String?
  offerPrice  Int?
  offerStatus OfferStatus?

  fromUser User @relation("SentMessages",    fields: [fromUserId], references: [id])
  toUser   User @relation("ReceivedMessages", fields: [toUserId],   references: [id])

  createdAt DateTime @default(now())
}

model LeagueMessage {
  id         String   @id @default(cuid())
  leagueId   String
  fromUserId String
  text       String
  createdAt  DateTime @default(now())

  fromUser   User     @relation("LeagueMessages", fields: [fromUserId], references: [id])
}

// ─── LEAGUE ───────────────────────────────────────────────────────────────────

model League {
  id             String          @id @default(cuid())
  name           String
  startingBudget Int
  maxClubs       Int             @default(18)
  seasonLength   Int             @default(34)
  status         LeagueStatus    @default(SETUP)
  currentDay     Int             @default(0)
  matchTime      String          @default("20:00")
  squadSize      Int             @default(25)
  history        Json?
  hasCup             Boolean         @default(false)
  transferWindowOpen Boolean         @default(true)
  cupBracket         Json?
  competitionType    CompetitionType @default(LEAGUE)
  newsEvents         Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // ── Transfer window config ─────────────────────────────────────────────────
  windowDays      Int   @default(3)     // duration of initial window
  maxManualPicks  Int   @default(11)    // max players won from auctions before auto-fill
  releaseSchedule Json?                 // { "0": ["ST","CF",...], "1": [...], "2": [...] }
  wageCap         Int   @default(0)     // weekly wage cap per club (0 = disabled)

  clubs           Club[]
  matches         Match[]
  playerInstances PlayerInstance[]
  transferWindow  TransferWindow?
}

enum CompetitionType {
  LEAGUE
  WORLD_CUP
  CHAMPIONS_LEAGUE
}

enum LeagueStatus {
  SETUP
  DRAFTING
  ACTIVE
  FINISHED
}

// ─── CLUB ─────────────────────────────────────────────────────────────────────

model Club {
  id     String  @id @default(cuid())
  name   String
  budget Int
  isAI   Boolean @default(false)
  tactic      Json?
  logoConfig  Json?
  kitConfig   Json?
  physioLevel    Int @default(0)  // 0-2
  scoutLevel     Int @default(0)  // 0-3
  coachLevel     Int @default(0)  // 0-3
  trainerLevel   Int @default(0)  // 0-3
  marketingLevel Int @default(0)  // 0-3
  stadiumLevel   Int @default(0)  // 0-3
  trainingLevel  Int @default(0)  // 0-3
  kitLevel       Int @default(0)  // 0-3
  vipLevel       Int @default(0)  // 0-3
  fanMood               Int     @default(60) // 0-100
  managerSpecialization String?
  tacticFamiliarity     Int     @default(75) // 0-100
  lastTacticIdentity    String?

  leagueId String
  league   League @relation(fields: [leagueId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  wins         Int @default(0)
  draws        Int @default(0)
  losses       Int @default(0)
  goalsFor     Int @default(0)
  goalsAgainst Int @default(0)
  points       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  squad             PlayerInstance[]
  homeMatches       Match[]           @relation("HomeClub")
  awayMatches       Match[]           @relation("AwayClub")
  bids              Bid[]
  sponsorDeals      SponsorDeal[]
  transferListings  TransferListing[] @relation("SellerListings")
}

// ─── SPONSORS ─────────────────────────────────────────────────────────────────

model SponsorDeal {
  id           String            @id @default(cuid())
  clubId       String
  club         Club              @relation(fields: [clubId], references: [id])
  leagueId     String

  sponsorName  String
  sponsorEmoji String
  mission      String
  type         SponsorMissionType
  params       Json              // { instanceId?, playerName?, goals?, minRating? }

  cost         Int
  reward       Int

  status       SponsorDealStatus @default(ACTIVE)
  targetMatchday Int

  createdAt    DateTime @default(now())
}

enum SponsorMissionType {
  PLAY_PLAYER
  WIN_MATCH
  CLEAN_SHEET
  SCORE_GOALS
  PLAYER_RATING
}

enum SponsorDealStatus {
  ACTIVE
  COMPLETED
  FAILED
}

// ─── GLOBAL PLAYER POOL ───────────────────────────────────────────────────────

model Player {
  id          String   @id @default(cuid())
  name        String
  nationality String?
  position    Position
  age         Int
  potential   Int

  overall   Int
  pace      Int
  shooting  Int
  passing   Int
  dribbling Int
  defending Int
  physical  Int

  // ── Detailed attributes ───────────────────────────────────────────────────
  atkCrossing       Int @default(50)
  atkFinishing      Int @default(50)
  atkHeadAccuracy   Int @default(50)
  atkShortPassing   Int @default(50)
  atkVolleys        Int @default(50)
  sklDribbling      Int @default(50)
  sklCurve          Int @default(50)
  sklFkAccuracy     Int @default(50)
  sklLongPassing    Int @default(50)
  sklBallControl    Int @default(50)
  movAcceleration   Int @default(50)
  movSprintSpeed    Int @default(50)
  movAgility        Int @default(50)
  movReactions      Int @default(50)
  movBalance        Int @default(50)
  powShotPower      Int @default(50)
  powJumping        Int @default(50)
  powStamina        Int @default(50)
  powStrength       Int @default(50)
  powLongShots      Int @default(50)
  menAggression     Int @default(50)
  menInterceptions  Int @default(50)
  menPositioning    Int @default(50)
  menVision         Int @default(50)
  menPenalties      Int @default(50)
  menComposure      Int @default(50)
  defMarkingAware   Int @default(50)
  defStandingTackle Int @default(50)
  defSlidingTackle  Int @default(50)
  gkDiving          Int @default(10)
  gkHandling        Int @default(10)
  gkKicking         Int @default(10)
  gkPositioning     Int @default(10)
  gkReflexes        Int @default(10)
  gkSpeed           Int @default(10)
  weakFoot          Int @default(3)
  skillMoves        Int @default(3)
  heightCm          Int @default(181)

  positions      String[]
  preferredRoles String[]
  baseValue      Int
  photoUrl       String?
  personalities  String[] @default([])

  instances PlayerInstance[]
}

enum Position {
  GK
  CB
  LB
  RB
  CDM
  CM
  CAM
  LM
  RM
  LW
  RW
  CF
  ST
}

// ─── PLAYER INSTANCE (mutable state per league) ───────────────────────────────

model PlayerInstance {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  leagueId String
  league   League @relation(fields: [leagueId], references: [id])

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  morale  Int @default(70)
  form    Int @default(70)
  fitness Int @default(90)

  injured           Boolean @default(false)
  injuryDaysLeft    Int     @default(0)
  suspendedMatchday Int?
  yellowCards       Int     @default(0)
  trainedPosition   String?

  wage Int @default(0)

  discoveredPersonalities String[] @default([])
  fanFavouriteScore       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  performances    MatchPerformance[]
  transferListing TransferListing?
  boosts          PlayerBoost[]
  auction         Auction?

  @@unique([playerId, leagueId])
}

// ─── TRANSFER MARKET ──────────────────────────────────────────────────────────

model TransferListing {
  id           String   @id @default(cuid())
  leagueId     String
  sellerClubId String
  instanceId   String   @unique
  askingPrice  Int

  instance   PlayerInstance @relation(fields: [instanceId], references: [id])
  sellerClub Club           @relation("SellerListings", fields: [sellerClubId], references: [id])

  createdAt  DateTime @default(now())
}

// ─── MATCHES ──────────────────────────────────────────────────────────────────

model Match {
  id       String      @id @default(cuid())
  matchday Int
  status   MatchStatus @default(SCHEDULED)

  leagueId String
  league   League @relation(fields: [leagueId], references: [id])

  homeClubId String
  homeClub   Club   @relation("HomeClub", fields: [homeClubId], references: [id])

  awayClubId String
  awayClub   Club   @relation("AwayClub", fields: [awayClubId], references: [id])

  homeScore Int?
  awayScore Int?

  competition String @default("LEAGUE")
  cupRound    String?

  homeLineup Json?
  awayLineup Json?
  homeTactic Json?
  awayTactic Json?
  stats      Json?

  simulatedAt DateTime?

  events       MatchEvent[]
  performances MatchPerformance[]
}

enum MatchStatus {
  SCHEDULED
  SIMULATED
}

model MatchEvent {
  id      String    @id @default(cuid())
  matchId String
  match   Match     @relation(fields: [matchId], references: [id])

  minute Int
  type   EventType
  detail Json?
}

enum EventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  PENALTY_MISS
}

model MatchPerformance {
  id         String         @id @default(cuid())
  matchId    String
  match      Match          @relation(fields: [matchId], references: [id])
  instanceId String
  instance   PlayerInstance @relation(fields: [instanceId], references: [id])

  rating           Float
  goals            Int     @default(0)
  assists          Int     @default(0)
  minutesPlayed    Int     @default(0)
  positionPlayed   String?
}

// ─── PLAYER BOOSTS ───────────────────────────────────────────────────────────

model PlayerBoost {
  id            String         @id @default(cuid())
  leagueId      String
  instanceId    String
  instance      PlayerInstance @relation(fields: [instanceId], references: [id])
  stat          String
  amount        Int
  matchdaysLeft Int
  createdAt     DateTime       @default(now())
}

// ─── TRANSFER WINDOW (initial squad building) ────────────────────────────────

model TransferWindow {
  id       String       @id @default(cuid())
  leagueId String       @unique
  league   League       @relation(fields: [leagueId], references: [id])

  status  WindowStatus @default(PENDING)
  opensAt DateTime?

  auctions Auction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WindowStatus {
  PENDING
  OPEN
  CLOSED
}

model Auction {
  id         String         @id @default(cuid())
  windowId   String
  window     TransferWindow @relation(fields: [windowId], references: [id])
  leagueId   String
  instanceId String         @unique
  instance   PlayerInstance @relation(fields: [instanceId], references: [id])

  openingBid   Int
  currentBid   Int
  winnerClubId String?

  releasedAt DateTime
  endsAt     DateTime
  status     AuctionStatus @default(SCHEDULED)

  bids      Bid[]
  watchedBy WatchlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AuctionStatus {
  SCHEDULED
  OPEN
  WON
  UNSOLD
}

model Bid {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id])
  clubId    String
  club      Club    @relation(fields: [clubId], references: [id])

  amount  Int
  maxBid  Int?    // proxy bid maximum (private  -  never exposed to other clubs)
  isProxy Boolean @default(false)

  createdAt DateTime @default(now())
}

model WatchlistEntry {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id])
  clubId    String

  createdAt DateTime @default(now())

  @@unique([auctionId, clubId])
}
